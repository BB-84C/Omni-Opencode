{
  "name": "omni-opencode",
  "version": "0.1.0",
  "description": "OpenCode plugin for delegated external subagents backed by Codex and Claude Code",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./server": {
      "import": "./dist/plugin.js",
      "config": {
        "enabled": true
      }
    },
    "./tui": {
      "import": "./dist/tui.js",
      "config": {
        "enabled": true
      }
    }
  },
  "scripts": {
    "build": "tsc && tsc -p tsconfig.scripts.json",
    "bootstrap:windows-psmux": "node ./scripts/windows-psmux-bootstrap.mjs",
    "release:pack": "node ./scripts/package-release.mjs",
    "test": "vitest run --exclude test/release-install.test.ts",
    "test:release:contract": "vitest run test/release-manifest.test.ts test/release-package.test.ts",
    "test:release:install": "npx vitest run test/release-install.test.ts",
    "test:release": "npm run test:release:contract && npm run test:release:install",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/claude-code": "^1.0.0",
    "node-pty": "^1.0.0",
    "@opencode-ai/plugin": "^1.3.13",
    "@opencode-ai/sdk": "^1.3.13",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
